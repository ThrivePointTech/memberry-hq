# Inlined into the client/server bundle at `next build` time — not readable
# at container runtime. If you're building a Docker image, pass this as a
# build arg (--build-arg NEXT_PUBLIC_API_URL=...), not just `docker run -e`.
NEXT_PUBLIC_API_URL=http://localhost:3000

# AuthJS session encryption secret. Generate with `npx auth secret`.
AUTH_SECRET=

# Google OAuth client for Workspace SSO (Google Cloud Console, Workspace-linked project).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared with memberry-api's JWT_SECRET — must be the exact same value, used
# to mint/verify the superadmin JWT and the short-lived SSO provisioning JWT.
JWT_SECRET=
